{
  "L01": [
    "Vous souhaitez rejoindre",
    "la Fédération des Entreprises du Gabon ?",
    "Voici comment adhérer,",
    "étape par étape."
  ],
  "L02": [
    "D'abord, une condition impérative :",
    "être une entreprise formelle."
  ],
  "L03": [
    "Immatriculée au registre du commerce,",
