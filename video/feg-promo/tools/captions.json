{
  "L01": ["L'histoire économique d'un pays", "s'écrit sur le terrain,", "dans la sueur des ateliers", "et le risque des entrepreneurs."],
  "L02": ["Mais seule, une entreprise", "peine à se faire entendre,", "et pèse peu sur les décisions", "qui la concernent."],
  "L03": ["Depuis 1959,", "la Fédération des Entreprises du Gabon", "rassemble ceux qui font", "l'économie du pays :", "plus de 1 100 entreprises,", "réparties en 13 fédérations métiers."],
  "L04": ["Ensemble, elles représentent", "près de 80 % du PIB,", "et plus de 90 %", "de la main-d'œuvre formelle."],
  "L05": ["Sa raison d'être :", "porter votre voix.", "Informer, promouvoir,", "participer aux négociations,", "défendre vos intérêts."],
  "L06": ["Votre préoccupation remonte", "par votre fédération métier", "jusqu'au Bureau exécutif,", "puis à la table", "du dialogue public-privé."],
  "L06b": ["Il ne passe pas que", "par les grands forums :", "au sortir des travaux rapportés", "par les fédérations métiers,", "des réunions se tiennent", "avec le secteur public."],
  "L07": ["Ce dialogue a son grand rendez-vous :", "le Gabon Economic Forum.", "Lors de sa dernière édition,", "ses huit ateliers ont abouti", "à la Déclaration de Libreville."],
  "L08": ["La dette intérieure, la fiscalité,", "la commande publique,", "le financement des PME :", "ensemble, les entreprises pèsent", "désormais sur les réformes du pays."],
  "L09": ["Adhérer, c'est aussi profiter", "d'une veille sur les réformes,", "de formations,", "d'un réseau d'affaires", "aux tarifs négociés,", "et d'un service de médiation", "et d'arbitrage."],
  "L10": ["Des entreprises fortes,", "une croissance durable,", "une prospérité partagée.", "Votre entreprise a sa place", "à nos côtés :", "rejoignez la Fédération", "des Entreprises du Gabon."]
}
